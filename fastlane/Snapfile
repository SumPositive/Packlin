# fastlane snapshot 設定（Packlin / モチメモ）
# ------------------------------------------------------------
# 5カット × 8言語 × iPhone/iPad で撮る構成
#
# App Store 必須サイズ:
#   - iPhone 6.9": iPhone 17 Pro Max（1320x2868）
#   - iPad 13":    iPad Pro 13-inch (M5)  … 審査必須枠。iPhone が埋まってから追加
#
# 【注意】devices([...]) の名前は `xcrun simctl list devices` に出る名前と一致必須。

# iPhone 6.9" と iPad 13" の両方を撮る。
devices([
  "iPhone 17 Pro Max",
  "iPad Pro 13-inch (M5)"
])

# 片方だけ撮りたい場合はどちらかをコメントアウトする。

# 言語コード = 出力フォルダ名（App Store のロケール名に一致させる）かつ -AppleLanguages。
# 言語切替は SnapshotHelper が language.txt（=この値）で行う。
# 8言語（ja/en/de/es/fr/it/ko/zh-Hant の .lproj）に対応。DialSplit と同じロケール名
# ※ en-US / de-DE / es-ES / fr-FR は地域付きでも、iOS が先頭の言語(en/de/es/fr)で .lproj を解決する
# ※ 繁体字は zh-Hant のまま渡す（zh-Hant-TW などにすると .lproj と一致せずフォールバックする）
languages(["ja","en-US","de-DE","es-ES","fr-FR","it","ko","zh-Hant"])

# 撮影対象スキーム
scheme("Packlin")

# 撮影用 UITest を明示指定する。
# 撮影は「スクショ専用の UITest ターゲット」PackListSnapshotUITests に置く。
# こうすることで、通常の Test 実行（Cmd+U / 既存 PackListUITests）では撮影が走らない。
# TestPlan 経由だと UITest が実行されず snapshot() が呼ばれない（結果0枚）ことがあるため、
# 撮影対象を UITest のメソッドに固定する。
only_testing(["PackListSnapshotUITests/PacklinSnapshotUITests/testTakeScreenshots"])

# 出力先。deliver がここから拾う
output_directory("./fastlane/screenshots")

# iPhone/iPad 両方を全カット撮り直すので、古いファイルを消してクリーンに出力する。
clear_previous_screenshots(true)

# 起動を安定させる
stop_after_first_error(true)
concurrent_simulators(false)

# --- シミュレータ起動失敗（Clone の launch-failed / RequestDenied）対策 ---
# USB上のXcodeでクローン起動が拒否されることがあるため、リトライを増やす。
# 失敗が続く場合は、実行前に `xcrun simctl shutdown all` +
# `sudo killall -9 com.apple.CoreSimulator.CoreSimulatorService` でクリーンにする。
number_of_retries(3)

# --- サンプルパックを毎回入れ直す ---
# サンプルパックは「パックが1つも無いとき」だけ投入され、そのときタグ式に変換される。
# 前回撮影のデータが残っているとグループ式の古いサンプルのままになるので、撮影ごとにアプリを入れ直す。
reinstall_app(true)
app_identifier("com.azukid.AzPackList5")
