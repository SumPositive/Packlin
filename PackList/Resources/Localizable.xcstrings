    "watch.ad.send.free.finish.video": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anzeige ansehen und kostenlos senden.\n Sieh das Video bis zum Ende an, um zu senden. Chappy mini übernimmt, daher können Details knapper sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch an ad to send for free.\n Finish the video to start sending. Chappy mini handles it, so details may be lighter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve un anuncio para enviar gratis.\n Termina el video para empezar a enviar. Chappy mini lo gestiona, así que puede tener menos detalle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez une pub pour envoyer gratuitement.\n Terminez la vidéo pour démarrer l’envoi. Chappy mini s’en charge, donc les détails peuvent être plus légers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda un annuncio per inviare gratis.\n Completa il video per iniziare l’invio. Se ne occupa Chappy mini, quindi i dettagli potrebbero essere più leggeri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告を見て無料で送信！\n　動画広告を最後まで視聴すると送信が始まります。チャッピー mini に依頼しますので少し情報量は減るかも知れませんがお試しください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고를 보고 무료로 전송하세요.\n 동영상 광고를 끝까지 시청하면 전송이 시작됩니다. Chappy mini가 처리하므로 정보량이 조금 줄 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觀看廣告即可免費送出。\n 影片觀看完畢後會開始送出。由 Chappy mini 處理，內容可能較精簡"
          }
        }
      }
    },
