    "tickets.live.device.if.s.lost": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tickets bleiben auf diesem Gerät. Wenn es verloren geht oder die App gelöscht wird, sind sie weg. Nutze sie bald."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tickets live on this device. If it's lost or the app is removed, they're gone—use them soon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tickets viven en este dispositivo. Si se pierde o se borra la app, se pierden; úsalos pronto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tickets restent sur cet appareil. S’il est perdu ou si l’app est supprimée, ils disparaissent. Utilisez-les bientôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I ticket restano su questo dispositivo. Se viene perso o l’app viene rimossa, andranno persi: usali presto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI利用券は端末に安全に保管されますが、端末が壊れたりアプリを削除すると失われます。貯めずに早めにお使いください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 이용권은 이 기기에 보관됩니다. 기기를 잃어버리거나 앱을 삭제하면 사라지니 빨리 사용해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用券保存在此裝置。若裝置遺失或刪除 App，使用券會消失，請盡早使用"
          }
        }
      }
    },
    "tickets.remain.buy.more.once.re": {
      "localizations": {
        "de": {
