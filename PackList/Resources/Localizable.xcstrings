    "public.pack.share.description": {
      "comment": "公開パックの共有リンクの使い方を説明する本文",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Link führt zu diesem öffentlichen Pack. Kopiere ihn und füge ihn in soziale Medien oder eine Nachricht ein. Wer den Link erhält, kann dieses öffentliche Pack importieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This link points to this public pack. Copy and paste it into social media or a message. Anyone who receives it can import this public pack."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace lleva a este pack público. Cópialo y pégalo en una red social o mensaje. Quien lo reciba podrá importar este pack público."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien mène à ce pack public. Copiez-le et collez-le dans un réseau social ou un message. Toute personne qui le reçoit peut importer ce pack public."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo link porta a questo pack pubblico. Copialo e incollalo in un social network o in un messaggio. Chiunque lo riceva può importare questo pack pubblico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この公開パックへのリンクです。コピーしてSNSやメッセージに貼り付けてください。リンクを受け取った人は、この公開パックを取り込むことができます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 링크는 이 공개 팩으로 연결됩니다. 복사하여 SNS나 메시지에 붙여 넣으세요. 링크를 받은 사람은 이 공개 팩을 가져올 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此連結會開啟這個公開行李包。請複製並貼到社群媒體或訊息中。收到連結的人可以匯入這個公開行李包。"
          }
        }
      }
    },
