    "publish.privacy.notice": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine persönlichen Infos im Memo einfügen. Veröffentlichte Packs können von anderen Nutzern angesehen und importiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not include personal info in the memo. Published packs can be viewed and imported by other users."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No incluyas información personal en la nota. Otros usuarios pueden ver e importar los packs publicados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’incluez pas d’informations personnelles dans le mémo. Les packs publiés peuvent être vus et importés par d’autres utilisateurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non includere dati personali nel memo. I pack pubblicati possono essere visti e importati da altri utenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモに個人情報を含めないでください。公開パックは他のユーザーが閲覧・取り込みできます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모에 개인정보를 포함하지 마세요. 공개 팩은 다른 사용자가 보고 가져올 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請勿在備註中包含個人資訊。公開行李包可被其他使用者查看與匯入"
          }
        }
      }
    },
