    "publish.help.caution": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine persönlichen Informationen einfügen! Packs können nach Ermessen des Autors entfernt werden, wenn sie als unangemessen gemeldet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not include personal information! Packs may be removed at the author’s discretion if reported as inappropriate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡No incluyas información personal! Los packs pueden eliminarse a criterio del autor si se reportan como inapropiados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’incluez pas d’informations personnelles ! Les packs peuvent être supprimés à la discrétion de l’auteur s’ils sont signalés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non includere informazioni personali! I pack possono essere rimossi a discrezione dell’autore se segnalati come inappropriati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人情報を含めないでください！不適切報告があれば作者の独断で削除する場合があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인정보를 포함하지 마세요! 부적절 신고가 있으면 작성자 판단으로 삭제될 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請勿包含個人資訊！若被檢舉不適當，作者可能自行判斷刪除"
          }
        }
      }
    },
    "publish.help.line1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert dieses Pack in der Cloud und veröffentlicht es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves this pack to the cloud and publishes it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda este pack en la nube y lo publica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre ce pack dans le cloud et le publie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva questo pack nel cloud e lo pubblica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパックをクラウドに保存して公開します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 팩을 클라우드에 저장하고 공개합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將此行李包儲存到雲端並公開"
          }
        }
      }
    },
    "publish.help.line2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder weltweit kann es importieren und nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone in the world can import and use it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier persona del mundo puede importarlo y usarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le monde peut l’importer et l’utiliser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiunque nel mondo può importarlo e usarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "世界中のユーザが取り込んで利用できるようになります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전 세계 사용자가 가져와 사용할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "世界各地使用者都可匯入並使用"
          }
        }
      }
    },
    "publish.help.line3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern desselben Packs überschreibt es; du kannst es also auch als Backup nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving the same pack overwrites it, so you may use this for backup purposes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar el mismo pack lo sobrescribe, así que también puedes usarlo como copia de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer le même pack l’écrase ; vous pouvez donc l’utiliser comme sauvegarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvare lo stesso pack lo sovrascrive, quindi puoi usarlo anche come backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じパックを保存すると上書きしますのでバックアップ目的で使われても構いません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 팩을 저장하면 덮어쓰므로 백업 용도로도 사용할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存相同行李包會覆寫，因此也可作為備份用途"
          }
        }
      }
    },
    "publish.nickname.anonymous.publish": {
      "localizations": {
        "de": {
