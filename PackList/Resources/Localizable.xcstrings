    "list.changes.want.up.count.chars": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste die gewünschten Änderungen auf.\n(bis zu %lld Zeichen)\n(z. B.) 6 Nächte, Griechenland hinzufügen, Großeltern kommen mit, Regen einplanen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List the changes you want.\n(up to %lld chars)\n(e.g.) 6 nights, add Greece, grandparents join, plan for rain"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enumera los cambios que quieres.\n(hasta %lld caracteres)\n(ej.) 6 noches, añadir Grecia, vienen los abuelos, prever lluvia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listez les changements souhaités.\n(jusqu’à %lld caractères)\n(ex.) 6 nuits, ajouter la Grèce, grands-parents présents, prévoir la pluie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elenca le modifiche desiderate.\n(fino a %lld caratteri)\n(es.) 6 notti, aggiungi Grecia, nonni presenti, prevedi pioggia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更の要望をたくさん列記してください\n（最大%lld文字）\n（例）6泊に変更、ギリシャも訪問、祖父母も参加、雨天も想定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원하는 변경 사항을 적어 주세요.\n(최대 %lld자)\n(예) 6박으로 변경, 그리스도 방문, 조부모도 참가, 우천 대비"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "列出想要變更的內容。\n（最多 %lld 字）\n（例）改為6晚、也去希臘、祖父母同行、考慮雨天"
          }
        }
      }
    },
    "list.places.dates.purpose.crew.weather": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste Orte, Termine, Zweck, Personen, Wetter und Pläne auf.\n(bis zu %lld Zeichen)\n(z. B.) 5 Nächte Italien & Spanien, 4 Personen, Sommerhitze beachten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List places, dates, purpose, crew, weather, plans.\n(up to %lld chars)\n(e.g.) 5-night Italy & Spain, 4 people, summer heat aware"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enumera lugares, fechas, objetivo, personas, clima y planes.\n(hasta %lld caracteres)\n(ej.) Italia y España 5 noches, 4 personas, considerar calor de verano"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listez lieux, dates, objectif, personnes, météo et activités.\n(jusqu’à %lld caractères)\n(ex.) Italie & Espagne 5 nuits, 4 personnes, prévoir la chaleur d’été"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elenca luoghi, date, scopo, persone, meteo e attività.\n(fino a %lld caratteri)\n(es.) Italia e Spagna 5 notti, 4 persone, attenzione al caldo estivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訪問先、日程、目的、人数、気候、アクティビティなどの要望をたくさん列記してください\n（最大%lld文字）\n（例）海外旅行5泊6日、イタリア、スペイン、家族4人、8月の気候に配慮して"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방문지, 일정, 목적, 인원, 날씨, 활동 등을 적어 주세요.\n(최대 %lld자)\n(예) 이탈리아와 스페인 5박, 4명, 여름 더위 고려"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "列出地點、日期、目的、人數、天氣、活動等需求。\n（最多 %lld 字）\n（例）義大利與西班牙5晚、4人、考慮夏季炎熱"
          }
        }
      }
    },
