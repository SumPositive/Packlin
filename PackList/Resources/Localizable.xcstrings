    "chappy.thinking.ll.ping.can.close": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chappy denkt nach. Wir melden uns. Du kannst schließen und die App weiter nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
