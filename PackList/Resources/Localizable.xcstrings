    "public.pack.import.ad.body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst dieses Pack importieren, nachdem du eine kurze Videoanzeige bis zum Ende angesehen hast. Danke für die Unterstützung!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can import this pack after watching a short video ad to the end. Thanks for supporting the developer!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes importar este pack después de ver un anuncio de video corto hasta el final. ¡Gracias por apoyar al desarrollador!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez importer ce pack après avoir regardé une courte publicité vidéo jusqu’à la fin. Merci de soutenir le développeur !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi importare questo pack dopo aver guardato fino alla fine un breve annuncio video. Grazie per il supporto!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短い動画広告を最後まで視聴すると、このパックを取り込めます。開発者の応援にご協力ありがとうございます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 동영상 광고를 끝까지 시청하면 이 팩을 가져올 수 있습니다. 개발자 응원 감사합니다!"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觀看短影片廣告到最後後，即可匯入此行李包。感謝支持開發者！"
          }
        }
      }
    },
