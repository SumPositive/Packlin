    "watch.end.support.dev.chip.only": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zum Ende ansehen, um den Entwickler zu unterstützen! Nur beitragen, wenn es für dich passt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch to the end to support the dev! Chip in only if it feels right."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Míralo hasta el final para apoyar al desarrollador. Aporta solo si te parece bien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez jusqu’à la fin pour soutenir le développeur ! Participez seulement si vous le souhaitez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda fino alla fine per supportare lo sviluppatore! Contribuisci solo se ti va."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告を最後まで見れば、開発者を直接応援できます！無理のない範囲でご協力いただけると嬉しいです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끝까지 시청하면 개발자를 직접 응원할 수 있습니다! 무리 없는 범위에서 도와주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觀看到最後即可支持開發者！請在不勉強的範圍內支持"
          }
        }
      }
    },
