    "tell.chappy.what.need.tap.send": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag Chappy, was du brauchst, und tippe auf Senden. Prüfe und passe die Vorschläge an. Ein KI-Ticket pro Sendung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell Chappy what you need and tap Send. Review and tweak the ideas Chappy returns. One AI ticket per send."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dile a Chappy lo que necesitas y toca Enviar. Revisa y ajusta las ideas que devuelva. Un ticket de IA por envío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites à Chappy ce dont vous avez besoin puis touchez Envoyer. Vérifiez et ajustez ses idées. Un ticket IA par envoi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dì a Chappy cosa ti serve e tocca Invia. Controlla e modifica le idee restituite. Un ticket IA per invio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要望を入力して「送信」ボタンを押せば、チャッピーにパックの作成や変更を依頼できます。チャッピーから届いた提案を眺めて修正しながらご利用ください。AI利用券1枚で1回の送信が可能です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요한 내용을 Chappy에게 알려주고 전송을 누르세요. 제안을 확인하고 수정해 보세요. 전송 1회당 AI 이용권 1장이 필요합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "告訴 Chappy 你的需求並點選送出。收到建議後可確認與調整。每次送出使用 1 張 AI 使用券"
          }
        }
      }
    },
