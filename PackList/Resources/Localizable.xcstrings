    "publish.quota.exceeded": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dein Veröffentlichungslimit erreicht. Lösche einige veröffentlichte Packs und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
