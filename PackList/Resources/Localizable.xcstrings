    "data.may.be.corrupted.tapping.reset": {
      "comment": "The text below the \"Reset and Restart\" button in the \"Database Error\" view.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten sind möglicherweise beschädigt.\n„Zurücksetzen und neu starten“ sichert die beschädigten Daten\nund startet die App beim nächsten Mal frisch.\n\nWenn Packs fehlen, stelle sie aus einem Backup wieder her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data may be corrupted.\nTapping \"Reset and Restart\" will back up the corrupted data,\nand the app will launch fresh on the next start.\n\nIf your packs are missing, restore from a backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos pueden estar dañados.\nAl tocar “Restablecer y reiniciar”, se hará copia de los datos dañados\ny la app se iniciará limpia la próxima vez.\n\nSi faltan packs, restaura desde una copia de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données peuvent être corrompues.\nTouchez « Réinitialiser et redémarrer » pour sauvegarder les données corrompues\net relancer l’app à neuf au prochain démarrage.\n\nSi vos packs manquent, restaurez une sauvegarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati potrebbero essere danneggiati.\nToccando “Ripristina e riavvia” verranno salvati i dati danneggiati\ne l’app partirà pulita al prossimo avvio.\n\nSe mancano pack, ripristina da un backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データが破損している可能性があります。\n「リセットして再起動」をタップすると破損データを退避し、\n次回起動時にクリーンな状態でアプリが起動します。\n\nパックが消えた場合は、バックアップから復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터가 손상되었을 수 있습니다.\n“리셋 후 재시작”을 누르면 손상 데이터를 백업하고\n다음 실행 시 깨끗한 상태로 시작합니다.\n\n팩이 사라졌다면 백업에서 복원해 주세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料可能已損壞。\n點選「重置並重新啟動」會備份損壞資料，\n下次啟動時以全新狀態開啟 App。\n\n如果行李包遺失，請從備份還原"
          }
        }
      }
    },
